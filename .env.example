# ExpenseFlow Production Configuration
# Copy this file to .env and adjust values for your environment

# Flask Application Environment (production / development)
FLASK_ENV=production
FLASK_DEBUG=false

# Secret Key for session signing and security (generate a random 32+ char string in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-32-chars

# Database location (relative path or absolute path)
DATABASE_PATH=expenses.db

# Server Bind Port
PORT=5000
HOST=0.0.0.0
